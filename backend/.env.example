# Backend RiderSync — copie para .env (desenvolvimento) e .env.test (testes).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ridersync:ridersync_dev_only@localhost:5432/ridersync?schema=public
# Origem(ns) do frontend autorizadas (separadas por vírgula). Em dev o Vite faz proxy de /api.
# Aceita curinga `*` restrito a UM rótulo DNS, ex.: https://ridersync-front-*-<time>.vercel.app
CORS_ORIGINS=http://localhost:5173
# Cookie de sessão: true em produção (HTTPS). Em dev local (HTTP) deve ser false.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Armazenamento de arquivos: local | s3 | vercel-blob
# Na Vercel use vercel-blob (store PRIVADO conectado ao projeto: a Vercel injeta BLOB_READ_WRITE_TOKEN).
# Disco local não é persistente na Vercel e é recusado lá.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=./storage
# Somente se STORAGE_DRIVER=s3 (compatível com S3/MinIO)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Seeds de demonstração (dados fictícios) — nunca em produção.
SEED_DEMO=false
