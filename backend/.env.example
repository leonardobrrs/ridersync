# Backend RiderSync — copie para .env (desenvolvimento) e .env.test (testes).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ridersync:ridersync_dev_only@localhost:5432/ridersync?schema=public
# Origem(ns) do frontend autorizadas (separadas por vírgula). Em dev o Vite faz proxy de /api.
# Aceita curinga `*` restrito a UM rótulo DNS, ex.: https://ridersync-front-*-<time>.vercel.app
CORS_ORIGINS=http://localhost:5173
# Cookie de sessão: true em produção (HTTPS). Em dev local (HTTP) deve ser false.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Armazenamento de arquivos: local | s3 | vercel-blob
# Na Vercel use vercel-blob (store PRIVADO conectado ao projeto: a Vercel injeta BLOB_READ_WRITE_TOKEN).
# Disco local não é persistente na Vercel e é recusado lá.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
STORAGE_LOCAL_DIR=./storage
# Somente se STORAGE_DRIVER=s3 (compatível com S3/MinIO)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Seeds de demonstração (dados fictícios) — nunca em produção.
SEED_DEMO=false

# ── URLs e segredos ──
# Origem pública da SPA (links de e-mail e redirect do Google). Preview: https://ridersync-front-<...>.vercel.app
PUBLIC_APP_URL=http://localhost:5173
# Obrigatório em produção (mín. 32 caracteres): assina links de descadastro e o estado do OAuth.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Protege GET /api/internal/maintenance (o Cron da Vercel envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# ── E-mail (Resend) ──
# resend = envio real | log = desenvolvimento (NÃO envia; registra e, opcionalmente, grava JSON) | disabled
# Padrão: log em desenvolvimento/testes; disabled em produção (sem envio e sem simulação).
MAIL_DRIVER=log
# brevo: API transacional da Brevo (MAIL_FROM deve ser remetente/domínio verificado na conta)
BREVO_API_KEY=
RESEND_API_KEY=
# Remetente com domínio verificado no Resend
MAIL_FROM="RiderSync <nao-responda@ridersync.app>"
# Somente dev/testes: grava os e-mails do driver "log" em arquivos JSON
MAIL_DEV_OUTBOX_DIR=
# true = a conta só entra após confirmar o e-mail. Padrão false: confirmação posterior, acesso imediato.
EMAIL_VERIFICATION_REQUIRED=false

# ── Login com Google (OAuth 2.0) ──
# Redirect URI autorizado no Google Cloud: ${PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Segurança e LGPD ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PRIVACY_CONTACT_EMAIL=privacidade@ridersync.app
