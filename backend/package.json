{
  "name": "@ridersync/backend",
  "private": true,
  "version": "0.1.0",
  "description": "RiderSync API — monólito modular NestJS",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev:neon": "dotenv -o -e .env.neon -- nest start --watch",
    "dev:neon:staging": "dotenv -o -e .env.neon-staging -- sh -c '[ \"$NEON_BRANCH\" = ridersync-staging ] || { echo \"ABORTADO: .env.neon-staging nao aponta para ridersync-staging\" >&2; exit 1; } && exec nest start --watch'",
    "start:prod": "prisma migrate deploy && node dist/seed/demo-seed.js && node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:migrate:neon": "dotenv -o -e .env.neon -- sh -c 'DATABASE_URL=\"$DATABASE_URL_UNPOOLED\" prisma migrate deploy'",
    "db:status:neon:staging": "dotenv -o -e .env.neon-staging -- sh -c '[ \"$NEON_BRANCH\" = ridersync-staging ] || { echo \"ABORTADO: .env.neon-staging nao aponta para ridersync-staging\" >&2; exit 1; } && DATABASE_URL=\"$DATABASE_URL_UNPOOLED\" exec prisma migrate status'",
    "db:migrate:neon:staging": "dotenv -o -e .env.neon-staging -- sh -c '[ \"$NEON_BRANCH\" = ridersync-staging ] || { echo \"ABORTADO: .env.neon-staging nao aponta para ridersync-staging\" >&2; exit 1; } && DATABASE_URL=\"$DATABASE_URL_UNPOOLED\" exec prisma migrate deploy'",
    "seed": "tsx src/seed/demo-seed.ts --force",
    "admin:hash": "node scripts/admin-hash.mjs",
    "seed:showcase": "tsx src/seed/showcase-seed.ts --force --with-demo",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:int": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:db:prepare": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.8.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "numero-por-extenso": "1.0.8",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "8.0.0",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "engines": {
    "node": "22.x"
  }
}
